# Configure only the provider(s) you use. Never commit your .env.
OPENAI_API_KEY=yourOpenaiSecretKey
GEMINI_API_KEY=yourGoogleAiSecretKey
NUBBIX_PROVIDER=openai
NUBBIX_OPENAI_MODEL=gpt-6-luna
NUBBIX_GOOGLE_MODEL=gemini-3.5-flash-lite
NUBBIX_REASONING_EFFORT=xhigh
NUBBIX_TICKET_USD=0.05
NUBBIX_CAMPAIGN_USD=2
NUBBIX_TIMEOUT_SECONDS=15
NUBBIX_DEADLINE_SECONDS=60
NUBBIX_MAX_OUTPUT_TOKENS=8192
